datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// Identity & Multi-Tenancy (Workspaces)
// -------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  displayName  String
  timezone     String   @default("UTC")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  ownedWorkspaces   Workspace[]        @relation("WorkspaceOwner")
  workspaceMembers  WorkspaceMember[]
  agentRuns         AgentRun[]
  actionDecisions   ActionApproval[]   @relation("ApprovalDecider")
  requestedApprovals ActionApproval[]  @relation("ApprovalRequester")
  notificationJobs  NotificationJob[]
  memories          UserMemory[]
  auditEvents       AuditEvent[]

  @@map("users")
}

model Workspace {
  id          String   @id @default(uuid())
  name        String
  ownerUserId String   @map("owner_user_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  owner         User                  @relation("WorkspaceOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  members       WorkspaceMember[]
  goals         Goal[]
  tasks         Task[]
  connections   IntegrationConnection[]
  agentRuns     AgentRun[]
  actionApprovals ActionApproval[]
  notifications NotificationJob[]
  memories      UserMemory[]
  auditEvents   AuditEvent[]

  @@map("workspaces")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  workspaceId String        @map("workspace_id")
  userId      String        @map("user_id")
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@map("workspace_members")
}

// -------------------------------------------------------------
// Goals, Versions & Milestones
// -------------------------------------------------------------

enum GoalType {
  MILESTONE_DRIVEN
  HABITUAL
  TIME_BOUND
  OPEN_ENDED
}

enum GoalStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Goal {
  id          String     @id @default(uuid())
  workspaceId String     @map("workspace_id")
  title       String
  description String?
  goalType    GoalType   @default(MILESTONE_DRIVEN) @map("goal_type")
  status      GoalStatus @default(ACTIVE)
  targetDate  DateTime?  @map("target_date")
  priority    Priority   @default(MEDIUM)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  versions    GoalVersion[]
  milestones  Milestone[]
  tasks       Task[]
  exitRamps   ExitRamp[]
  autopsies   PlanAutopsy[]

  @@index([workspaceId, status])
  @@map("goals")
}

model GoalVersion {
  id             String    @id @default(uuid())
  goalId         String    @map("goal_id")
  version        Int
  definitionJson Json      @map("definition_json")
  approvedAt     DateTime? @map("approved_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@unique([goalId, version])
  @@map("goal_versions")
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Milestone {
  id          String          @id @default(uuid())
  goalId      String          @map("goal_id")
  title       String
  description String?
  dueAt       DateTime?       @map("due_at")
  status      MilestoneStatus @default(PENDING)
  orderIndex  Int             @default(0) @map("order_index")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  goal  Goal   @relation(fields: [goalId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([goalId, orderIndex])
  @@map("milestones")
}

// -------------------------------------------------------------
// Tasks & Dependencies
// -------------------------------------------------------------

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
  BLOCKED
}

model Task {
  id               String     @id @default(uuid())
  workspaceId      String     @map("workspace_id")
  goalId           String?    @map("goal_id")
  milestoneId      String?    @map("milestone_id")
  title            String
  notes            String?
  status           TaskStatus @default(TODO)
  estimatedMinutes Int        @default(30) @map("estimated_minutes")
  dueAt            DateTime?  @map("due_at")
  completedAt      DateTime?  @map("completed_at")
  priority         Priority   @default(MEDIUM)
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  goal        Goal?       @relation(fields: [goalId], references: [id], onDelete: SetNull)
  milestone   Milestone?  @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  dependencies TaskDependency[] @relation("DependentTask")
  dependents   TaskDependency[] @relation("PrerequisiteTask")

  @@index([workspaceId, status, dueAt])
  @@index([goalId])
  @@map("tasks")
}

model TaskDependency {
  id               String   @id @default(uuid())
  taskId           String   @map("task_id")
  dependsOnTaskId  String   @map("depends_on_task_id")
  createdAt        DateTime @default(now()) @map("created_at")

  task             Task     @relation("DependentTask", fields: [taskId], references: [id], onDelete: Cascade)
  prerequisiteTask Task     @relation("PrerequisiteTask", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnTaskId])
  @@map("task_dependencies")
}

// -------------------------------------------------------------
// Integrations: Connections, Encrypted Credentials, Permissions
// -------------------------------------------------------------

enum ConnectionStatus {
  CONNECTED
  EXPIRED
  REVOKED
  ERROR
}

model IntegrationConnection {
  id                String           @id @default(uuid())
  workspaceId       String           @map("workspace_id")
  provider          String           // "google_calendar", "github", "mcp", etc.
  providerAccountId String           @map("provider_account_id")
  status            ConnectionStatus @default(CONNECTED)
  metadata          Json?
  lastSyncedAt      DateTime?        @map("last_synced_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  workspace   Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  credentials IntegrationCredential?
  permissions IntegrationPermission[]
  events      IntegrationEvent[]

  @@unique([workspaceId, provider, providerAccountId])
  @@index([workspaceId, provider])
  @@map("integration_connections")
}

model IntegrationCredential {
  id                    String    @id @default(uuid())
  connectionId          String    @unique @map("connection_id")
  encryptedAccessToken  String    @map("encrypted_access_token")
  encryptedRefreshToken String?   @map("encrypted_refresh_token")
  tokenExpiresAt        DateTime? @map("token_expires_at")
  keyId                 String    @default("v1") @map("key_id")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@map("integration_credentials")
}

enum PermissionStatus {
  GRANTED
  REVOKED
  PENDING
}

model IntegrationPermission {
  id           String           @id @default(uuid())
  connectionId String           @map("connection_id")
  scope        String
  status       PermissionStatus @default(GRANTED)
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, scope])
  @@map("integration_permissions")
}

// -------------------------------------------------------------
// Agent Runs, Tool Calls & Human Approval Policies
// -------------------------------------------------------------

enum AgentRunStatus {
  QUEUED
  RUNNING
  WAITING_FOR_APPROVAL
  SUCCEEDED
  FAILED
  CANCELLED
}

model AgentRun {
  id                String         @id @default(uuid())
  workspaceId       String         @map("workspace_id")
  userId            String         @map("user_id")
  status            AgentRunStatus @default(QUEUED)
  model             String
  prompt            String
  planSummary       String?        @map("plan_summary")
  resumedFromStepId String?        @map("resumed_from_step_id")
  checkpointState   Json?          @map("checkpoint_state")
  currentStepIndex  Int            @default(0) @map("current_step_index")
  startedAt         DateTime?      @map("started_at")
  finishedAt        DateTime?      @map("finished_at")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  toolCalls ToolCall[]
  steps     AgentStep[]

  @@index([workspaceId, status])
  @@map("agent_runs")
}

enum RiskLevel {
  READ_ONLY
  LOW_RISK_INTERNAL_WRITE
  EXTERNAL_WRITE
  SENSITIVE_ACTION
  HIGH_IMPACT_ACTION
}

enum ToolCallStatus {
  PENDING
  APPROVED
  REJECTED
  EXECUTING
  COMPLETED
  FAILED
}

model ToolCall {
  id            String         @id @default(uuid())
  agentRunId    String         @map("agent_run_id")
  toolName      String         @map("tool_name")
  inputPayload  Json           @map("input_payload")
  inputSummary  String         @map("input_summary")
  riskLevel     RiskLevel      @default(READ_ONLY) @map("risk_level")
  status        ToolCallStatus @default(PENDING)
  resultPayload Json?          @map("result_payload")
  resultSummary String?        @map("result_summary")
  error         String?
  executedAt    DateTime?      @map("executed_at")
  createdAt     DateTime       @default(now()) @map("created_at")

  agentRun AgentRun        @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  approval ActionApproval?

  @@index([agentRunId, status])
  @@map("tool_calls")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

model ActionApproval {
  id              String         @id @default(uuid())
  toolCallId      String         @unique @map("tool_call_id")
  workspaceId     String         @map("workspace_id")
  requestedById   String         @map("requested_by_id")
  actionSummary   String         @map("action_summary")
  riskLevel       RiskLevel      @map("risk_level")
  status          ApprovalStatus @default(PENDING)
  decisionById    String?        @map("decision_by_id")
  decisionAt      DateTime?      @map("decision_at")
  expiresAt       DateTime       @map("expires_at")
  createdAt       DateTime       @default(now()) @map("created_at")

  toolCall    ToolCall  @relation(fields: [toolCallId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  requester   User      @relation("ApprovalRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  decider     User?     @relation("ApprovalDecider", fields: [decisionById], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@map("action_approvals")
}

// -------------------------------------------------------------
// Inbound Integration Events, Background Notifications & Memory
// -------------------------------------------------------------

model IntegrationEvent {
  id              String    @id @default(uuid())
  connectionId    String    @map("connection_id")
  providerEventId String    @map("provider_event_id")
  eventType       String    @map("event_type")
  payload         Json
  processedAt     DateTime? @map("processed_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, providerEventId])
  @@index([connectionId, processedAt])
  @@map("integration_events")
}

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
}

enum NotificationStatus {
  QUEUED
  DELIVERED
  CANCELLED
  FAILED
}

model NotificationJob {
  id               String              @id @default(uuid())
  workspaceId      String              @map("workspace_id")
  userId           String              @map("user_id")
  title            String
  body             String
  channel          NotificationChannel @default(IN_APP)
  scheduledAt      DateTime            @map("scheduled_at")
  status           NotificationStatus  @default(QUEUED)
  deduplicationKey String?             @unique @map("deduplication_key")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, scheduledAt])
  @@map("notification_jobs")
}

enum MemoryType {
  PREFERENCE
  FACT
  CONSTRAINT
  TEMPORAL
}

model UserMemory {
  id          String     @id @default(uuid())
  workspaceId String     @map("workspace_id")
  userId      String     @map("user_id")
  memoryType  MemoryType @map("memory_type")
  content     String
  source      String     @default("user_input")
  confidence  Float      @default(1.0)
  expiresAt   DateTime?  @map("expires_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, userId, memoryType])
  @@map("user_memory")
}

// -------------------------------------------------------------
// Audit Trail
// -------------------------------------------------------------

enum ActorType {
  USER
  AGENT
  SYSTEM
  INTEGRATION
}

model AuditEvent {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  actorId     String?   @map("actor_id")
  actorType   ActorType @default(USER) @map("actor_type")
  action      String
  targetType  String    @map("target_type")
  targetId    String    @map("target_id")
  metadata    Json?
  ipAddress   String?   @map("ip_address")
  userAgent   String?   @map("user_agent")
  createdAt   DateTime  @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([targetType, targetId])
  @@map("audit_events")
}

// -------------------------------------------------------------
// Phase 1: Stateful Agent Resumption & Daily Digest
// -------------------------------------------------------------

enum AgentStepStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

model AgentStep {
  id             String          @id @default(uuid())
  agentRunId     String          @map("agent_run_id")
  stepNumber     Int             @map("step_number")
  name           String
  status         AgentStepStatus @default(PENDING)
  inputPayload   Json?           @map("input_payload")
  outputPayload  Json?           @map("output_payload")
  stateSnapshot  Json?           @map("state_snapshot")
  error          String?
  durationMs     Int?            @map("duration_ms")
  startedAt      DateTime?       @map("started_at")
  finishedAt     DateTime?       @map("finished_at")
  createdAt      DateTime        @default(now()) @map("created_at")

  agentRun AgentRun @relation(fields: [agentRunId], references: [id], onDelete: Cascade)

  @@unique([agentRunId, stepNumber])
  @@index([agentRunId, status])
  @@map("agent_steps")
}

enum DigestItemStatus {
  PENDING_REVIEW
  REVIEWED
  DISMISSED
}

model DailyReviewDigestItem {
  id          String           @id @default(uuid())
  workspaceId String           @map("workspace_id")
  userId      String           @map("user_id")
  agentRunId  String?          @map("agent_run_id")
  title       String
  summary     String
  category    String           @default("agent_result")
  payload     Json?
  status      DigestItemStatus @default(PENDING_REVIEW)
  createdAt   DateTime         @default(now()) @map("created_at")
  reviewedAt  DateTime?        @map("reviewed_at")

  @@index([workspaceId, userId, status])
  @@map("daily_review_digest_items")
}

// -------------------------------------------------------------
// Phase 2: Plan Autopsy (Deterministic Cause + AI Narrative)
// -------------------------------------------------------------

enum AutopsyCause {
  ESTIMATE_MISS
  CAPACITY_CLASH
  BLOCKER
  AVOIDANCE
  CHANGED_ASSUMPTION
  AGENT_FAILURE
}

model PlanAutopsy {
  id                 String       @id @default(uuid())
  workspaceId        String       @map("workspace_id")
  goalId             String?      @map("goal_id")
  taskId             String?      @map("task_id")
  primaryCause       AutopsyCause @map("primary_cause")
  evidencePacket     Json         @map("evidence_packet")
  explanation        String
  rankedRecoveryJson Json         @map("ranked_recovery_json")
  userVerifiedCause  String?      @map("user_verified_cause")
  createdAt          DateTime     @default(now()) @map("created_at")

  goal Goal? @relation(fields: [goalId], references: [id], onDelete: SetNull)

  @@index([workspaceId, primaryCause])
  @@map("plan_autopsies")
}

// -------------------------------------------------------------
// Phase 3: Exit Ramps (Pre-Committed Stop/Pivot Signals)
// -------------------------------------------------------------

enum ExitRampStatus {
  MONITORING
  TRIGGERED
  ACKNOWLEDGED
  PIVOTED
}

enum ExitSignalType {
  SCHEDULE_SLIP_DAYS
  BUDGET_OVERRUN
  CONSECUTIVE_UNRESOLVED_BLOCKERS
  EFFORT_THRESHOLD
}

model ExitRamp {
  id             String         @id @default(uuid())
  workspaceId    String         @map("workspace_id")
  goalId         String         @map("goal_id")
  signalType     ExitSignalType @map("signal_type")
  thresholdValue Float          @map("threshold_value")
  description    String
  status         ExitRampStatus @default(MONITORING)
  triggeredAt    DateTime?      @map("triggered_at")
  evidenceJson   Json?          @map("evidence_json")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@map("exit_ramps")
}

// -------------------------------------------------------------
// Phase 4: Capacity Pools in /planner
// -------------------------------------------------------------

model CapacityPoolSnapshot {
  id                String   @id @default(uuid())
  workspaceId       String   @map("workspace_id")
  date              DateTime @db.Date
  focusHoursBudget  Float    @default(4.0) @map("focus_hours_budget")
  focusHoursPlanned Float    @default(0.0) @map("focus_hours_planned")
  agentQuotaLimit   Int      @default(50)  @map("agent_quota_limit")
  agentQuotaUsed    Int      @default(0)   @map("agent_quota_used")
  reviewQuotaLimit  Int      @default(5)   @map("review_quota_limit")
  reviewQuotaUsed   Int      @default(0)   @map("review_quota_used")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@unique([workspaceId, date])
  @@map("capacity_pool_snapshots")
}

// -------------------------------------------------------------
// Phase 5: Trust Ledger & Absence Autopilot
// -------------------------------------------------------------

enum AgentPermissionLevel {
  PROPOSE_ONLY
  ACT_WITH_NOTIFICATION
}

model AgentTrustLedger {
  id                   String               @id @default(uuid())
  workspaceId          String               @map("workspace_id")
  agentType            String               @map("agent_type")
  permissionLevel      AgentPermissionLevel @default(PROPOSE_ONLY) @map("permission_level")
  consecutiveApprovals Int                  @default(0) @map("consecutive_approvals")
  totalApprovals       Int                  @default(0) @map("total_approvals")
  totalRejections      Int                  @default(0) @map("total_rejections")
  lastDemotedAt        DateTime?            @map("last_demoted_at")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")

  @@unique([workspaceId, agentType])
  @@map("agent_trust_ledgers")
}

model UserAbsenceState {
  id                 String    @id @default(uuid())
  workspaceId        String    @map("workspace_id")
  userId             String    @map("user_id")
  lastActiveAt       DateTime  @default(now()) @map("last_active_at")
  isAutopilotActive  Boolean   @default(false) @map("is_autopilot_active")
  autopilotStartedAt DateTime? @map("autopilot_started_at")
  daysSlid           Int       @default(0) @map("days_slid")
  pausedRecurrences  Boolean   @default(false) @map("paused_recurrences")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@unique([workspaceId, userId])
  @@map("user_absence_states")
}
