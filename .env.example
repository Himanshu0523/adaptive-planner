# Environment Configuration for Adaptive Planner Backend
NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://app:local_dev_only@127.0.0.1:5432/personal_agent?schema=public"

# Redis & Background Workers
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# App & Web URLs
APP_URL=http://localhost:4000
WEB_APP_URL=http://localhost:3000

# AI Model Gateway (Google Gemini default)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional Secondary Provider Fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Security & Secrets
OAUTH_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
SESSION_SECRET=dev-session-secret-change-in-production-min32chars
JWT_SECRET=dev-jwt-secret-change-in-production-min32chars

# OAuth Integrations (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/integrations/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/api/v1/integrations/github/callback
